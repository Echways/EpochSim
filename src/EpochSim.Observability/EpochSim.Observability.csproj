<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EpochSim.Kernel\EpochSim.Kernel.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageDescription>Tracing and profiling helpers for EpochSim runs, including JSONL trace/profile writers and fingerprints.</PackageDescription>
    <PackageTags>epochsim;deterministic;simulation;observability;tracing;profiling;timeline;jsonl</PackageTags>
    <Authors>Echways</Authors>
    <PackageProjectUrl>https://github.com/Echways/EpochSim</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Echways/EpochSim</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
