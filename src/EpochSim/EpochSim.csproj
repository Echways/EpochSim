<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EpochSim.Execution\EpochSim.Execution.csproj" />
    <ProjectReference Include="..\EpochSim.Serialization\EpochSim.Serialization.csproj" />
    <ProjectReference Include="..\EpochSim.Observability\EpochSim.Observability.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>EpochSim</PackageId>

    <PackageDescription>Facade-first package for EpochSim: ergonomic entrypoints, quick presets, and minimal wiring for deterministic runs.</PackageDescription>
    <PackageTags>epochsim;facade;embedding;simulation;deterministic;artifacts;quickstart</PackageTags>
    <Authors>Echways</Authors>
    <PackageProjectUrl>https://github.com/Echways/EpochSim</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Echways/EpochSim</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
