<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageType>Dependency</PackageType>

    <PackageId>EpochSim.All</PackageId>
    <PackageDescription>Meta-package that references the core EpochSim libraries (Kernel, Execution, Serialization, Observability).</PackageDescription>
    <PackageTags>epochsim;meta;all;deterministic;simulation</PackageTags>
    <Authors>Echways</Authors>
    <PackageProjectUrl>https://github.com/Echways/EpochSim</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Echways/EpochSim</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EpochSim.Kernel\EpochSim.Kernel.csproj" />
    <ProjectReference Include="..\EpochSim.Execution\EpochSim.Execution.csproj" />
    <ProjectReference Include="..\EpochSim.Hosting\EpochSim.Hosting.csproj" />
    <ProjectReference Include="..\EpochSim.Serialization\EpochSim.Serialization.csproj" />
    <ProjectReference Include="..\EpochSim.Observability\EpochSim.Observability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
