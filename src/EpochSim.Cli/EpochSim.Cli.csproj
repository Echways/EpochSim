<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EpochSim.Execution\EpochSim.Execution.csproj" />
    <ProjectReference Include="..\EpochSim\EpochSim.csproj" />
    <ProjectReference Include="..\EpochSim.Samples\EpochSim.Samples.csproj" />
    <ProjectReference Include="..\EpochSim.Observability\EpochSim.Observability.csproj" />
    <ProjectReference Include="..\EpochSim.Serialization\EpochSim.Serialization.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>epochsim</ToolCommandName>
    <PackageDescription>Command-line tools to run, validate, replay, inspect, and analyze EpochSim simulation artifacts.</PackageDescription>
    <PackageTags>epochsim;cli;dotnet-tool;simulation;deterministic;replay;events;trace;analysis</PackageTags>
    <Authors>Echways</Authors>
    <PackageProjectUrl>https://github.com/Echways/EpochSim</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Echways/EpochSim</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
