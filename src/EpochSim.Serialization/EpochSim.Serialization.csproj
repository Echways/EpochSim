<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EpochSim.Kernel\EpochSim.Kernel.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageDescription>Event log, snapshot, and state fingerprint serialization for EpochSim (JSONL v2).</PackageDescription>
    <PackageTags>epochsim;deterministic;simulation;serialization;event-log;jsonl;snapshots;fingerprints</PackageTags>
    <Authors>Echways</Authors>
    <PackageProjectUrl>https://github.com/Echways/EpochSim</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Echways/EpochSim</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
